<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>급여 계산기</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
body{
    font-family:sans-serif;
    max-width:700px;
    margin:30px auto;
    padding:20px;
}

input{
    width:100%;
    padding:10px;
    margin-bottom:10px;
}

button{
    padding:12px;
    width:100%;
    margin-top:10px;
}

.result{
    background:#f3f3f3;
    padding:15px;
    margin-top:20px;
    border-radius:10px;
}
</style>
</head>

<body>

<h2>급여 계산기</h2>

<input id="month" placeholder="지급월 (2026-10)">
<input id="name" placeholder="성명">
<input id="salary" type="number" placeholder="기본급">
<input id="meal" type="number" placeholder="식대">

<button onclick="calculate()">급여계산</button>
<button onclick="downloadPDF()">PDF 다운로드</button>

<div class="result" id="result"></div>

<script>

let payrollData = {};

function calculate(){

    const month =
      document.getElementById('month').value;

    const name =
      document.getElementById('name').value;

    const salary =
      Number(document.getElementById('salary').value);

    const meal =
      Number(document.getElementById('meal').value);

    const total = salary + meal;

    const pension =
      Math.round(salary * 0.045);

    const health =
      Math.round(salary * 0.03545);

    const care =
      Math.round(health * 0.1295);

    const employment =
      Math.round(salary * 0.009);

    const deduction =
      pension +
      health +
      care +
      employment;

    const net =
      total - deduction;

    payrollData = {
      month,
      name,
      salary,
      meal,
      pension,
      health,
      care,
      employment,
      deduction,
      net
    };

    document.getElementById('result').innerHTML = `
      <h3>계산결과</h3>

      총지급액 :
      ${total.toLocaleString()} 원<br>

      국민연금 :
      ${pension.toLocaleString()} 원<br>

      건강보험 :
      ${health.toLocaleString()} 원<br>

      장기요양 :
      ${care.toLocaleString()} 원<br>

      고용보험 :
      ${employment.toLocaleString()} 원<br>

      공제합계 :
      ${deduction.toLocaleString()} 원<br><br>

      <b>실수령액 :
      ${net.toLocaleString()} 원</b>
    `;
}


function downloadPDF(){

    const { jsPDF } =
      window.jspdf;

    const doc =
      new jsPDF();

    doc.setFontSize(16);

    doc.text("Payroll Statement",20,20);

    doc.setFontSize(11);

    doc.text(
      `Month : ${payrollData.month}`,
      20,40
    );

    doc.text(
      `Name : ${payrollData.name}`,
      20,50
    );

    doc.text(
      `Salary : ${payrollData.salary.toLocaleString()} KRW`,
      20,65
    );

    doc.text(
      `Meal : ${payrollData.meal.toLocaleString()} KRW`,
      20,75
    );

    doc.text(
      `Pension : ${payrollData.pension.toLocaleString()} KRW`,
      20,90
    );

    doc.text(
      `Health : ${payrollData.health.toLocaleString()} KRW`,
      20,100
    );

    doc.text(
      `Care : ${payrollData.care.toLocaleString()} KRW`,
      20,110
    );

    doc.text(
      `Employment : ${payrollData.employment.toLocaleString()} KRW`,
      20,120
    );

    doc.text(
      `Net Pay : ${payrollData.net.toLocaleString()} KRW`,
      20,140
    );

    doc.save(
      `${payrollData.month}_${payrollData.name}_급여명세서.pdf`
    );

}

</script>

</body>
</html>
